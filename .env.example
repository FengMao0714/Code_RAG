# ============================================
# Code_RAG 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# ---------- LLM 配置 ----------
# MiMo-7B 在线 API（OpenAI 兼容接口）
# 示例：硅基流动、Together AI 等提供的 MiMo API
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=XiaomiMiMo/MiMo-7B-RL
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.6

# ---------- Embedding 配置 ----------
# 内置 profile：baseline / bge-m3 / e5-base / custom
# baseline 使用 BAAI/bge-large-zh-v1.5，并兼容旧索引 key
EMBEDDING_PROFILE=baseline
# custom profile 时使用此模型；内置 profile 会覆盖为对应模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
# 可选：覆盖 profile 默认前缀。E5 默认 query: / passage:
# EMBEDDING_QUERY_PREFIX="query: "
# EMBEDDING_DOCUMENT_PREFIX="passage: "
# 模型缓存目录（可选，默认使用 HuggingFace 默认缓存路径）
# EMBEDDING_CACHE_DIR=./models
# 只从本地路径或 HuggingFace 本地缓存加载；缓存不存在时不联网
# EMBEDDING_OFFLINE=true

# ---------- ChromaDB 配置 ----------
CHROMA_PERSIST_DIR=~/.code-rag/chroma

# ---------- 检索配置 ----------
RETRIEVAL_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.7

# ---------- 索引配置 ----------
# 增量更新追踪数据目录
INDEX_TRACKER_DIR=~/.code-rag/indexes
# 单个 chunk 最大 token 数
MAX_CHUNK_TOKENS=512
