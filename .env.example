# ============================================
# Code_RAG 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# ---------- LLM 配置 ----------
# MiMo-7B 在线 API（OpenAI 兼容接口）
# 示例：硅基流动、Together AI 等提供的 MiMo API
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=XiaomiMiMo/MiMo-7B-RL
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.6

# ---------- Embedding 配置 ----------
# 使用本地 Embedding 模型
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
# 模型缓存目录（可选，默认使用 HuggingFace 默认缓存路径）
# EMBEDDING_CACHE_DIR=./models

# ---------- ChromaDB 配置 ----------
CHROMA_PERSIST_DIR=~/.code-rag/chroma

# ---------- 检索配置 ----------
RETRIEVAL_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.5

# ---------- 索引配置 ----------
# 增量更新追踪数据目录
INDEX_TRACKER_DIR=~/.code-rag/indexes
# 单个 chunk 最大 token 数
MAX_CHUNK_TOKENS=512
